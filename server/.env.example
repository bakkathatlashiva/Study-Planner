DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_planner
DATABASE_SSL=false
DATABASE_POOL_MAX=10
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-3.6-flash
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
PORT=5000
ALLOWED_ORIGIN=https://your-app.vercel.app

# Valkey / Redis — get a free instance from Upstash (upstash.com) or Render
# Format: redis://:<password>@<host>:<port>  or  rediss://... for TLS
REDIS_URL=redis://default:<password>@<host>:6379

# Optional email notifications and verification
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
